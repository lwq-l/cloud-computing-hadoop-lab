{
  "name": "Hadoop HDFS Teaching Lab",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "hadoop",
  "containerUser": "hadoop",
  "postCreateCommand": "bash scripts/setup-hadoop.sh",
  "forwardPorts": [
    9870
  ],
  "portsAttributes": {
    "9870": {
      "label": "HDFS NameNode Web UI",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  }
}

{
  "name": "Hadoop HDFS Teaching Lab",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "JAVA_HOME": "/usr/lib/jvm/java-11-openjdk-amd64",
    "HADOOP_HOME": "/opt/hadoop",
    "HADOOP_CONF_DIR": "/opt/hadoop/etc/hadoop"
  },
  "postCreateCommand": "bash scripts/setup-hadoop.sh",
  "postStartCommand": "sudo /usr/sbin/sshd || true",
  "forwardPorts": [9870],
  "portsAttributes": {
    "9870": {
      "label": "HDFS NameNode Web UI",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
